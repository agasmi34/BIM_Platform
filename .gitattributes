# ==============================================================================
# BIM Platform - line-ending and diff policy.
# Repository line endings are LF (Architecture Gate BIM-AG-P0-T001 section 3 /
# Implementation Brief section 3). Binary assets must not be normalized.
# ==============================================================================

* text=auto eol=lf

# Explicit text/source types --------------------------------------------------
*.c        text eol=lf
*.h        text eol=lf
*.hpp      text eol=lf
*.hh       text eol=lf
*.hxx      text eol=lf
*.cpp      text eol=lf
*.cc       text eol=lf
*.cxx      text eol=lf
*.inl      text eol=lf
*.cmake    text eol=lf
CMakeLists.txt text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.ps1      text eol=lf
*.psm1     text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
.clang-format  text eol=lf
.clang-tidy    text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Binary assets - never normalize ---------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.dll  binary
*.lib  binary
*.exe  binary
*.pdb  binary
*.zip  binary
*.7z   binary
